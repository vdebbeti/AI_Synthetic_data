  ],
  "expected_outputs": [
    {"dataset": "LB", "path": "data/expected/LB_expected.csv"},
    {"dataset": "VS", "path": "data/expected/VS_expected.csv"},
    {"dataset": "ADLB", "path": "data/expected/ADLB_expected.csv"}
  ],
  "assertions": {
    "exact_column_match": true,
    "exact_row_count_match": true,
    "null_equals_blank": true
